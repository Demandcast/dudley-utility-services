{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(brand|pages/soq|pages/brand-voice|pages/social-pillars|pages/electric-transmission-v2|pages/electric-transmission-pillar|pages/electric-distribution-pillar|pages/fiber-optics-broadband-pillar|pages/gas-utility-pillar|pages/water-utility-pillar|pages/gas-utility-review)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/electric-transmission-garrett",
      "destination": "/pages/electric-transmission",
      "permanent": true
    },
    {
      "source": "/electrical-infrastructure",
      "destination": "/pages/electric-transmission",
      "permanent": true
    },
    {
      "source": "/pipeline-infrastructure",
      "destination": "/pages/water-and-wastewater",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#what",
      "permanent": true
    },
    {
      "source": "/why-dus",
      "destination": "/#why",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/pages/team",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/pages/meet-with-dudley",
      "permanent": true
    },
    {
      "source": "/meet-with-dudley",
      "destination": "/pages/meet-with-dudley",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/home"
    }
  ]
}